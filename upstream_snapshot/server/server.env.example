# PiAgent 网关环境变量模板
# 生产：复制为 /opt/piagent/server.env（systemd EnvironmentFile 加载），权限 600
# 本地：source 后启动 uvicorn 做真实 LLM 联调
# 注意：真实配置含 API Key，已被 .gitignore（*.env）排除，切勿提交

# ---- LLM 出口代理（OpenAI 兼容接口，base 需带版本路径）----
PIAGENT_LLM_BASE_URL=https://api.deepseek.com/v1
PIAGENT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PIAGENT_LLM_MODEL=deepseek-flash

# ---- 可选 ----
# PIAGENT_JWT_SECRET=change-me            # 不填则首启自动生成落盘 server/data/.jwt_secret
# PIAGENT_JWT_EXPIRE_HOURS=168
# PIAGENT_DATA_DIR=./data
