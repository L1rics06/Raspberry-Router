# PiAgent 网关 systemd 单元（分工2）
# 安装：
#   sudo cp piagent-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now piagent-server
# 敏感环境变量放 /opt/piagent/server.env（权限 600），不要写进本文件。
[Unit]
Description=PiAgent Gateway (VPS WebSocket relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/piagent/server
ExecStart=/opt/piagent/server/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
EnvironmentFile=-/opt/piagent/server.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
